{
  "schema_version": 1,
  "cases": [
    {
      "name": "applies token and substitutions",
      "setup": {
        "initialize": {
          "config": "config"
        },
        "approov_header": {
          "header": "Approov-Token",
          "prefix": "Bearer "
        },
        "binding_header": "Authorization",
        "substitution_headers": [
          {
            "header": "Api-Key",
            "prefix": "Bearer "
          }
        ],
        "substitution_query_params": [
          "a(b"
        ]
      },
      "request": {
        "url": "https://example.com/path?a(b=query-placeholder",
        "headers": {
          "Authorization": "Bearer binding-value",
          "Api-Key": "Bearer header-secret"
        },
        "session_headers": {
          "X-Session": "session-value"
        }
      },
      "sdk": {
        "token_results": [
          {
            "url": "https://example.com/path?a(b=query-placeholder",
            "result": {
              "status": "success",
              "token": "approov-token",
              "trace_id": "trace-123",
              "is_config_changed": true,
              "loggable_token": "loggable-token"
            }
          }
        ],
        "secure_string_results": [
          {
            "key": "header-secret",
            "result": {
              "status": "success",
              "secure_string": "live-header-secret"
            }
          },
          {
            "key": "query-placeholder",
            "result": {
              "status": "success",
              "secure_string": "live-query-secret"
            }
          }
        ]
      },
      "mutator": {
        "processed_request": {
          "mode": "recordAndAddHeader",
          "header": "X-Mutated",
          "value": "true"
        }
      },
      "expected": {
        "decision": "proceed",
        "sdk_message": "SUCCESS",
        "request_url_contains": "live-query-secret",
        "header_values": {
          "Approov-Token": "Bearer approov-token",
          "Approov-TraceID": "trace-123",
          "Api-Key": "Bearer live-header-secret",
          "X-Mutated": "true"
        },
        "sdk": {
          "data_hashes": [
            "Bearer binding-value"
          ],
          "fetched_config_count": 1
        },
        "recorded_mutations": {
          "token_header_key": "Approov-Token",
          "trace_id_header_key": "Approov-TraceID",
          "substitution_header_keys": [
            "Api-Key"
          ],
          "substitution_query_param_keys": [
            "a(b"
          ],
          "original_url": "https://example.com/path?a(b=query-placeholder"
        }
      }
    },
    {
      "name": "returns retry for no network",
      "setup": {
        "initialize": {
          "config": "config"
        }
      },
      "request": {
        "url": "https://example.com/protected"
      },
      "sdk": {
        "token_results": [
          {
            "url": "https://example.com/protected",
            "result": {
              "status": "noNetwork"
            }
          }
        ]
      },
      "expected": {
        "decision": "retry",
        "error": {
          "kind": "networkingError",
          "message_contains": "Approov token fetch"
        }
      }
    },
    {
      "name": "ignores requests when not initialized",
      "request": {
        "url": "https://example.com/protected"
      },
      "expected": {
        "decision": "ignore"
      }
    },
    {
      "name": "ignores request without url",
      "request": {
        "url": null
      },
      "expected": {
        "decision": "ignore"
      }
    },
    {
      "name": "ignores request when mutator excludes it",
      "setup": {
        "initialize": {
          "config": "config"
        }
      },
      "request": {
        "url": "https://example.com/protected"
      },
      "mutator": {
        "should_process_request": {
          "mode": "returnValue",
          "value": false
        }
      },
      "expected": {
        "decision": "ignore",
        "sdk": {
          "fetched_token_urls": []
        }
      }
    },
    {
      "name": "maps mutator should process networking error",
      "setup": {
        "initialize": {
          "config": "config"
        }
      },
      "request": {
        "url": "https://example.com/protected"
      },
      "mutator": {
        "should_process_request": {
          "mode": "throwError",
          "error": {
            "kind": "networkingError",
            "message_contains": "no network"
          }
        }
      },
      "expected": {
        "decision": "retry",
        "error": {
          "kind": "networkingError",
          "message_contains": "no network"
        }
      }
    },
    {
      "name": "maps mutator should process permanent error",
      "setup": {
        "initialize": {
          "config": "config"
        }
      },
      "request": {
        "url": "https://example.com/protected"
      },
      "mutator": {
        "should_process_request": {
          "mode": "throwError",
